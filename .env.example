# 로컬 개발용 예시. 실제 값은 `.env`에 복사해서 쓰고 커밋하지 않는다(.gitignore).
# 운영 비밀값은 Railway 환경변수에만 두고 사용자가 직접 입력한다.
PORT=3000
DATABASE_URL=postgresql://exam:exam@localhost:5432/exam
# 통합 테스트는 이 파일(.env)을 읽지 않고 항상 exam_test를 쓴다(개발 DB 보호).
# 다른 테스트 DB가 필요하면 셸에서 지정한다: TEST_DATABASE_URL=postgresql://…/이름_test npm test -w @exam/server
JWT_SECRET=dev-only-change-me
# 개발 중 화면을 다른 출처(예: 다른 포트·도메인)에서 열 때만 설정한다. 쉼표로 구분한다(예: http://localhost:5173,http://127.0.0.1:5173).
# 기본 개발 프록시(localhost:5173)는 Host가 유지되어 필요 없다. 비워 두면 같은 출처 요청만 허용한다.
ALLOWED_ORIGINS=
# 운영에서만: 프록시 홉 수(1~3, 기본 1). 배포 후 로그인 시도 제한 IP 확인에 따라 조정
