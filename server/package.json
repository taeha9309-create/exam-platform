{
  "name": "@exam/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js",
    "db:generate": "npm run prisma -- generate",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:deploy": "npm run prisma -- migrate deploy",
    "pretest": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "prebuild": "npm run db:generate"
  },
  "dependencies": {
    "@exam/shared": "^0.0.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
